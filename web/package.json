{
  "name": "teacherly-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:up": "node scripts/db-up.mjs",
    "db:down": "node scripts/db-down.mjs",
    "db:migrate": "pnpm --filter @teacherly/db migrate",
    "db:generate": "pnpm --filter @teacherly/db generate",
    "typecheck": "tsc --noEmit && pnpm -r --no-bail typecheck",
    "build": "pnpm typecheck && pnpm --filter @teacherly/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:core-purity": "node scripts/check-core-purity.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "check": "pnpm check:core-purity && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.9",
    "dotenv": "^17.2.3",
    "embedded-postgres": "16.15.0-beta.19",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
