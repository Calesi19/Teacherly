# Copy to web/.env (gitignored). `pnpm dev` copies it for you on first run.
# Every value here is a local-development placeholder. No real secrets.

# Matches docker-compose.yml. The embedded-Postgres fallback uses the same
# port and credentials, so this line is correct either way.
DATABASE_URL=postgres://teacherly:teacherly@127.0.0.1:5432/teacherly

# API port. The Vite dev server proxies /api here.
PORT=3000

# Port for the Vite dev client. Read by apps/web/vite.config.ts,
# playwright.config.ts and the server's DEV_CLIENT_ORIGIN default, so changing
# it here is enough if something else already holds 5173.
DEV_CLIENT_PORT=5173

# Origin allowed to make credentialed requests in development. Defaults to
# http://localhost:$DEV_CLIENT_PORT; set it only if that is not right.
# DEV_CLIENT_ORIGIN=http://localhost:5173

# The session cookie's Secure flag is ON unless this says exactly "false".
#
# Uncomment ONLY to develop against plain http on localhost. It is refused
# outright when NODE_ENV=production, so it cannot follow a .env into a deploy
# and quietly strip Secure from a 14-day session cookie. Leaving it unset — or
# forgetting it exists — keeps the cookie Secure, which is the point.
# COOKIE_SECURE=false
